```gitignore
# ==========================================
# Python
# ==========================================
__pycache__/
*.py[codz]
*$py.class
*.so

# Python packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Environment Variables and Secrets
# ==========================================
.env
.env.*
!.env.example
.envrc
.streamlit/secrets.toml

# ==========================================
# Testing and Coverage
# ==========================================
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover
.hypothesis/

# ==========================================
# Python Linters and Type Checkers
# ==========================================
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ==========================================
# Logs and Temporary Files
# ==========================================
*.log
tempCodeRunnerFile.py
.cache/
*.tmp
*.temp

# ==========================================
# Database Files
# ==========================================
db.sqlite3
db.sqlite3-journal

# ==========================================
# Jupyter Notebook
# ==========================================
.ipynb_checkpoints/

# ==========================================
# IDE and Editor
# ==========================================
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject

# ==========================================
# Operating System
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Project-Specific Files
# ==========================================

# Local datasets - review before committing any required sample data
data/

# Generated evaluation results
evaluation/results.json

# ==========================================
# Documentation Build
# ==========================================
docs/_build/
/site

# ==========================================
# Other Python Tools
# ==========================================
.pdm-python
.pdm-build/
.pixi/
__pypackages__/
.pybuilder/
target/
.installed.cfg

# ==========================================
# Application-Specific Secrets
# ==========================================
.streamlit/secrets.toml
```